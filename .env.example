# Salin menjadi .env (lokal) atau isi di Environment Variables Hostinger

# Google Sheets: service account JSON boleh ditulis dalam beberapa baris
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID spreadsheet yang sudah ada (opsional; setup membuat spreadsheet baru jika kosong)
GOOGLE_SHEET_ID=
# Alias yang juga diterima setelah setup
SPREADSHEET_ID=

# Alternatif autentikasi OAuth jika tidak memakai service account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Foto disimpan di server
FILES_USER=admin
FILES_PASS=
# Disarankan DI LUAR folder aplikasi, mis. /home/u123456789/hc-foto
FILES_DIR=./uploads
# Opsional
BASE_URL=
PORT=3000
TZ=Asia/Jakarta
